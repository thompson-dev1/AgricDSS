# Copy to .env.deploy and fill in real values. Keep .env.deploy private.
# Use an absolute path on persistent storage, not a temporary container path.
AGRIC_DATA_DIR=/srv/agric-dss/data
DOMAIN=agric.example.com

# Match these IDs to the owner of AGRIC_DATA_DIR on the host.
APP_UID=1000
APP_GID=1000

# Generate a unique value with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Required for account registration and email verification.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM="AGRIC DSS <no-reply@example.com>"

# Optional: number shown on farmer payment instructions.
PAYMENT_MOMO_NUMBER=
