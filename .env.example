# Local development can read the existing SQLite file without copying it.
AGRIC_DB_PATH=../database.sqlite

# For Netlify production, create a Turso database and set both values in the
# deployment environment. Never put a real auth token in this file.
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Generate a unique secret with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters

# SMTP settings for registration verification. Never commit real credentials.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
MAIL_FROM=AGRIC DSS <no-reply@example.com>

# Optional mobile money destination displayed on farmer payment request screens.
PAYMENT_MOMO_NUMBER=
